<?xml version="1.0" encoding="utf-8" ?>

<component name="MainScene" extends="Scene">

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>

        <!-- Silent looping video used to keep the Roku session active -->
        <Video
            id="keepAliveVideo"
            width="1280"
            height="720"
            translation="[0,0]"
            visible="true"
            loop="true"
            enableUI="false" />

        <!-- Slideshow -->
        <Poster
            id="posterA"
            width="1280"
            height="720"
            translation="[0,0]"
            loadDisplayMode="scaleToFit"
            opacity="1.0" />

        <Poster
            id="posterB"
            width="1280"
            height="720"
            translation="[0,0]"
            loadDisplayMode="scaleToFit"
            opacity="0.0" />

        <Timer
            id="slideTimer"
            repeat="false" />

        <Timer
            id="refreshTimer"
            duration="120"
            repeat="true" />

        <Animation
            id="fadeAToB"
            duration="0.6"
            repeat="false">

            <FloatFieldInterpolator
                key="[0.0,1.0]"
                keyValue="[1.0,0.0]"
                fieldToInterp="posterA.opacity" />

            <FloatFieldInterpolator
                key="[0.0,1.0]"
                keyValue="[0.0,1.0]"
                fieldToInterp="posterB.opacity" />

        </Animation>

        <Animation
            id="fadeBToA"
            duration="0.6"
            repeat="false">

            <FloatFieldInterpolator
                key="[0.0,1.0]"
                keyValue="[1.0,0.0]"
                fieldToInterp="posterB.opacity" />

            <FloatFieldInterpolator
                key="[0.0,1.0]"
                keyValue="[0.0,1.0]"
                fieldToInterp="posterA.opacity" />

        </Animation>

    </children>

</component>
