<?xml version="1.0" encoding="utf-8" ?>

<component name="MainScene" extends="Scene">

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>

        <Poster
            id="posterA"
            width="1280"
            height="720"
            translation="[0,0]"
            loadDisplayMode="scaleToFit"
            opacity="1.0" />

        <Poster
            id="posterB"
            width="1280"
            height="720"
            translation="[0,0]"
            loadDisplayMode="scaleToFit"
            opacity="0.0" />

        <!-- Controls the 10-second image rotation -->
        <Timer
            id="slideTimer"
            repeat="false" />

        <!-- Checks GitHub /media for changes every 2 minutes -->
        <Timer
            id="refreshTimer"
            duration="120"
            repeat="true" />

        <!-- Crossfade from Poster A to Poster B -->
        <Animation
            id="fadeAToB"
            duration="0.6"
            repeat="false">

            <FloatFieldInterpolator
                key="[0.0,1.0]"
                keyValue="[1.0,0.0]"
                fieldToInterp="posterA.opacity" />

            <FloatFieldInterpolator
                key="[0.0,1.0]"
                keyValue="[0.0,1.0]"
                fieldToInterp="posterB.opacity" />

        </Animation>

        <!-- Crossfade from Poster B back to Poster A -->
        <Animation
            id="fadeBToA"
            duration="0.6"
            repeat="false">

            <FloatFieldInterpolator
                key="[0.0,1.0]"
                keyValue="[1.0,0.0]"
                fieldToInterp="posterB.opacity" />

            <FloatFieldInterpolator
                key="[0.0,1.0]"
                keyValue="[0.0,1.0]"
                fieldToInterp="posterA.opacity" />

        </Animation>

    </children>

</component>
